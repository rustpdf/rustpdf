{
  "name": "rustpdf",
  "version": "0.4.3",
  "description": "Node.js binding for the rust-pdf core (generate, manipulate, sign and validate PDFs) via Koffi FFI.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://rustpdf.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rustpdf/rustpdf.git",
    "directory": "bindings/node"
  },
  "bugs": {
    "url": "https://github.com/rustpdf/rustpdf/issues"
  },
  "keywords": [
    "pdf",
    "pdf/a",
    "pdf/ua",
    "accessibility",
    "signature",
    "acroform",
    "ffi"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "koffi": "^2.8.0"
  },
  "optionalDependencies": {
    "@rustpdf/darwin-arm64": "0.4.3",
    "@rustpdf/linux-arm64-gnu": "0.4.3",
    "@rustpdf/linux-x64-gnu": "0.4.3",
    "@rustpdf/win32-x64-msvc": "0.4.3"
  },
  "scripts": {
    "test": "node test/run.js",
    "sync-versions": "node scripts/sync-versions.mjs"
  }
}
