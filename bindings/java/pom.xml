<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.rustpdf</groupId>
  <artifactId>rustpdf</artifactId>
  <version>0.4.7</version>
  <packaging>jar</packaging>

  <name>rustpdf</name>
  <description>Generate, edit, sign and process PDFs in Java: PDF/A, digital signatures (PAdES) with HSM support, AES-256 encryption, forms, stamping, redaction, extraction and rendering. Docs: https://rustpdf.dev/docs/java</description>
  <url>https://rustpdf.dev/docs/java</url>

  <!-- Central Portal requires license, scm and developer metadata on every release. -->
  <licenses>
    <license>
      <name>Proprietary — rust-pdf commercial license</name>
      <url>https://rustpdf.dev/license</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>rust-pdf</name>
      <email>support@rustpdf.dev</email>
      <organization>rust-pdf</organization>
      <organizationUrl>https://rustpdf.dev</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/rustpdf/rust-pdf.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/rustpdf/rust-pdf.git</developerConnection>
    <url>https://github.com/rustpdf/rust-pdf</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jna.version>5.14.0</jna.version>
    <!-- Default smoke main for local `mvn exec:java` (full surface, dev key).
         The release job overrides it with -Dexec.mainClass=dev.rustpdf.ReleaseSmoke
         (free surface only — the prod-key lib rejects the dev token). A literal
         <mainClass> in the plugin config would win over -D, so it MUST be this
         property reference. -->
    <exec.mainClass>dev.rustpdf.SmokeTest</exec.mainClass>
  </properties>

  <dependencies>
    <!-- Pure-Java FFI: loads libpdf_ffi, no native compile step. -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>${jna.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- `mvn test-compile exec:java` runs the full-surface smoke test. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>${exec.mainClass}</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    The `release` profile is activated by the CI publish job (`mvn -Prelease deploy`).
    It is OFF by default so local `mvn test-compile exec:java` stays fast and needs no
    GPG key. The release JAR is a single fat artifact: the release-java.yml workflow
    stages one prebuilt libpdf_ffi per platform under src/main/resources/<RESOURCE_PREFIX>/
    (e.g. darwin-aarch64/, linux-x86-64/, win32-x86-64/) before packaging, and JNA
    extracts the matching one from the classpath at runtime — so a single JAR runs on
    every supported platform (no per-OS classifier artifacts).
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- Central requires a -sources jar. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>

          <!-- Central requires a -javadoc jar. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
            <configuration>
              <!-- JNA mappings are intentionally terse; don't fail the build on them. -->
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <!-- Central requires every artifact to be GPG-signed. The key + passphrase
               are imported by the workflow; loopback lets gpg read the passphrase
               non-interactively in CI. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- Publishes to Maven Central via the Sonatype Central Portal (OSSRH is
               retired). Credentials come from a <server id="central"> entry in the
               CI settings.xml. autoPublish uploads + releases in one step. -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.5.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
