# ---- Server ----------------------------------------------------------------
PORT=3000
# Public URL of the site (used for Stripe success/cancel redirects)
BASE_URL=http://localhost:3000
PRODUCT_NAME=rust-pdf
SUPPORT_EMAIL=sales@casefy.io
# Where OEM / volume / PO enquiries are directed (used on the landing page).
SALES_EMAIL=sales@casefy.io
# Internal recipients notified on every sale/renewal (buyer, amount, validity).
# Comma-separated. Defaults to edivanteixeira@gmail.com,edivan@casefy.io if unset.
ADMIN_NOTIFY_EMAILS=edivanteixeira@gmail.com,edivan@casefy.io

# ---- Stripe ----------------------------------------------------------------
# Secret key (sk_test_... in dev, sk_live_... in prod)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret (whsec_...). From `stripe listen` in dev, or the
# dashboard webhook endpoint in prod.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# One Stripe Price per self-serve tier (price_...). For STRIPE_MODE=subscription
# these MUST be recurring (yearly) prices; for STRIPE_MODE=payment they must be
# one-time prices. The OEM tier is sales-led and has no price here.
#   Pro        → PDF/A + encryption                         (e.g. $1,490/yr)
#   Enterprise → Pro + signatures/PAdES + accessibility     (e.g. $3,000/yr)
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_ENTERPRISE=price_yyy
# Legacy single-price var; if set it seeds the Pro price when STRIPE_PRICE_ID_PRO
# is absent (back-compat only — prefer the tier-specific vars above).
# STRIPE_PRICE_ID=price_xxx
# 'subscription' = recurring annual; auto-renewal mints a fresh token each cycle
# (handled via the invoice.paid webhook). 'payment' = one-time 1-year token.
STRIPE_MODE=subscription

# ---- License minting -------------------------------------------------------
# Ed25519 secret SEED (64 hex chars). Generate with:
#   target/release/examples/licctl keygen
# The matching pubkey must be baked into the shipped binaries
# (RUSTPDF_LICENSE_PUBKEY at build time). KEEP THIS SECRET.
VENDOR_SEED=your_64_hex_seed_here
# Path to the licctl binary (default: ../target/release/examples/licctl)
# LICCTL_BIN=/app/bin/licctl
LICENSE_DAYS=365
# Fallback feature/tier spec for manual mints; tiered checkout overrides it per
# purchase. Accepts a tier name (pro|enterprise) or a feature list.
LICENSE_FEATURES=enterprise

# ---- SendGrid --------------------------------------------------------------
SENDGRID_API_KEY=SG.xxx
# Must be a verified sender / domain in SendGrid
SENDGRID_FROM=sales@casefy.io
SENDGRID_FROM_NAME=rust-pdf

# ---- Storage ---------------------------------------------------------------
# DB_PATH=/app/data/licenses.db
