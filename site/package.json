{
  "name": "rustpdf-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marketing site + Stripe checkout + license automation for rust-pdf",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "issue": "node scripts/issue.js",
