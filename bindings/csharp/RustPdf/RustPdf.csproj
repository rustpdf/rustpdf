<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NuGet package metadata -->
    <PackageId>RustPdf</PackageId>
    <Version>0.5.0</Version>
    <Authors>rust-pdf</Authors>
    <Company>rust-pdf</Company>
    <Description>Generate, edit, sign and process PDFs in .NET: PDF/A, AES-256 encryption, digital signatures (PAdES) with HSM support, forms, stamping, redaction, text extraction and page rendering. Works out of the box on macOS, Linux and Windows. Full docs: https://rustpdf.dev/docs/csharp</Description>
    <Copyright>Copyright (c) 2026 Edivan Teixeira and rust-pdf contributors</Copyright>
    <PackageProjectUrl>https://rustpdf.dev/docs/csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rustpdf/rustpdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;pdfa;signing;pades;acroform;accessibility;encryption</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- A managed assembly carrying native assets: keep it RID-agnostic so the
         single package restores on any of the bundled runtimes. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- We ship the .nupkg from CI; suppress the no-runtime-asset warning that
         fires during a plain dev `dotnet pack` before libs are staged. -->
    <NoWarn>$(NoWarn);NU5100;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed into the NuGet package root. -->
    <None Include="LICENSE" Pack="true" PackagePath="" />
    <None Include="../README.md" Pack="true" PackagePath="" />

    <!-- Native libraries, staged by CI into runtimes/<rid>/native/ before pack.
         .NET's default DllImport resolver loads the matching RID automatically;
         the Native.cs resolver only kicks in for the local dev (target/) tree.
         The glob is empty during a dev build, which is fine. -->
    <None Include="runtimes/**/*"
          Pack="true"
          PackagePath="runtimes/"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
